# Пример окружения для scripts/start.sh. Не содержит секретов.
# Export variables in your shell or copy backend settings to backend/.env.
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
# For a local classroom PostgreSQL installation:
# DATABASE_URL=postgresql+psycopg://dds:CHANGE_ME@127.0.0.1:5432/dds
# For a real installation disable demo and provide a unique bootstrap password:
# DEMO_MODE=false
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password
# Optional local model, after installing weights:
# AI_MODE=local
# AI_ENDPOINT=http://127.0.0.1:11434/v1
# AI_MODEL=qwen3-1.7b
# AI_TIMEOUT_SECONDS=60
# SPEECH_ENDPOINT=http://127.0.0.1:11435
